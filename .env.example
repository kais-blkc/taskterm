# Общий пароль доступа (нужен для входа и регистрации)
ACCESS_PASSWORD=change-me

# --- dev (pnpm dev) ---
# Postgres для разработки: docker compose -f docker-compose.dev.yml up -d
DATABASE_URL=postgres://taskterm:taskterm@localhost:5442/taskterm
PORT=3100

# --- docker compose (прод) ---
# пароль БД: openssl rand -base64 24 (в compose DATABASE_URL собирается сам)
POSTGRES_PASSWORD=change-me
# порт на хосте
APP_PORT=3100
# true, если приложение за HTTPS
COOKIE_SECURE=false
