# Секрет подписи JWT (обязателен в проде, ≥ 32 символов): openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me
# Первый админ: если админов в БД нет, этот пользователь будет создан (нужен ADMIN_PASSWORD)
# или, если уже существует, назначен админом
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=

# --- dev (pnpm dev) ---
# Postgres для разработки: docker compose -f docker-compose.dev.yml up -d
DATABASE_URL=postgres://taskterm:taskterm@localhost:5442/taskterm
PORT=3100

# --- docker compose (прод) ---
# пароль БД: openssl rand -base64 24 (в compose DATABASE_URL собирается сам)
POSTGRES_PASSWORD=change-me
# порт на хосте
APP_PORT=3100
# true, если приложение за HTTPS
COOKIE_SECURE=false
# true, если перед приложением reverse proxy (Caddy/nginx): IP клиента берётся из X-Forwarded-For
TRUST_PROXY=false
# Origin'ы (через запятую), с которых разрешены POST/PATCH/DELETE, кроме собственного хоста
ALLOWED_ORIGINS=
