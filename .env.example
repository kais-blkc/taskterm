# ============================================================
# taskterm: переменные окружения
# Деплой через Docker: cp .env.example .env, заполни блок "ОБЯЗАТЕЛЬНО"
# и запусти docker compose up -d --build
# ============================================================

# ---------- ОБЯЗАТЕЛЬНО (без них контейнер не стартует) ----------
# пароль БД: openssl rand -base64 24  (после первого старта не менять)
POSTGRES_PASSWORD=change-me
# секрет подписи токенов, >= 32 символов: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me

# ---------- Первый админ (заполнить для первого запуска) ----------
# Создаётся при старте, если в БД нет админов. После первого входа ADMIN_PASSWORD можно убрать.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=

# ---------- Сеть и nginx ----------
# порт на хосте, на который nginx проксирует
APP_PORT=3100
# 127.0.0.1 — приложение доступно только локально (через nginx); 0.0.0.0 — снаружи напрямую
APP_BIND=0.0.0.0
# true, если перед приложением nginx (IP клиента берётся из X-Forwarded-For)
TRUST_PROXY=false
# true, если снаружи HTTPS. При обычном HTTP должно быть false, иначе вход не работает
COOKIE_SECURE=false
# Origin'ы через запятую, с которых разрешены POST/PATCH/DELETE, кроме собственного хоста
ALLOWED_ORIGINS=

# ---------- Таймер работы ----------
# часовой пояс (IANA) для границ дней и периодов отчёта (1–15, 16–конец месяца)
TIME_ZONE=Europe/Moscow

# ---------- Telegram-уведомления (необязательно) ----------
# токен бота от @BotFather; бота должен опрашивать ровно один экземпляр приложения
TELEGRAM_BOT_TOKEN=
# публичный адрес для ссылок на задачи, без слеша в конце: https://taskterm.example.com
PUBLIC_URL=

# ---------- HTTPS через встроенный Caddy (необязательно, если есть свой nginx) ----------
# docker compose --profile https up -d ; тогда же COOKIE_SECURE=true, TRUST_PROXY=true, APP_BIND=127.0.0.1
DOMAIN=

# ---------- Только для разработки (pnpm dev), в Docker не используются ----------
# Postgres для разработки: docker compose -f docker-compose.dev.yml up -d
DATABASE_URL=postgres://taskterm:taskterm@localhost:5442/taskterm
PORT=3100
